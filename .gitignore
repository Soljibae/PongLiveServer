# This .gitignore file should be placed at the root of your repository directory
#
# Unity project path:
# /client/PongUnity
#
# Based on Unity.gitignore
#
/client/PongUnity/.utmp/
/client/PongUnity/[Ll]ibrary/
/client/PongUnity/[Tt]emp/
/client/PongUnity/[Oo]bj/
/client/PongUnity/[Bb]uild/
/client/PongUnity/[Bb]uilds/
/client/PongUnity/[Ll]ogs/
/client/PongUnity/[Uu]ser[Ss]ettings/
*.log

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/client/PongUnity/[Mm]emoryCaptures/

# Recordings can get excessive in size
/client/PongUnity/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /client/PongUnity/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/client/PongUnity/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
/client/PongUnity/.gradle/

# Autogenerated VS/MD/Consulo solution and project files
/client/PongUnity/ExportedObj/
/client/PongUnity/.consulo/
/client/PongUnity/*.csproj
/client/PongUnity/*.unityproj
/client/PongUnity/*.sln
/client/PongUnity/*.suo
/client/PongUnity/*.tmp
/client/PongUnity/*.user
/client/PongUnity/*.userprefs
/client/PongUnity/*.pidb
/client/PongUnity/*.booproj
/client/PongUnity/*.svd
/client/PongUnity/*.pdb
/client/PongUnity/*.mdb
/client/PongUnity/*.opendb
/client/PongUnity/*.VC.db

# Unity3D generated meta files
/client/PongUnity/*.pidb.meta
/client/PongUnity/*.pdb.meta
/client/PongUnity/*.mdb.meta

# Unity3D generated file on crash reports
/client/PongUnity/sysinfo.txt

# Builds
/client/PongUnity/*.apk
/client/PongUnity/*.aab
/client/PongUnity/*.unitypackage
/client/PongUnity/*.unitypackage.meta
/client/PongUnity/*.app

# Crashlytics generated file
/client/PongUnity/crashlytics-build.properties

# Packed Addressables
/client/PongUnity/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/client/PongUnity/[Aa]ssets/[Ss]treamingAssets/aa.meta
/client/PongUnity/[Aa]ssets/[Ss]treamingAssets/aa/*
