# This .gitignore file should be placed at the root of your repository directory
#
# Unity project path:
# /ClientTemp/PongUnity
#
# Based on Unity.gitignore
#
/ClientTemp/PongUnity/.utmp/
/ClientTemp/PongUnity/[Ll]ibrary/
/ClientTemp/PongUnity/[Tt]emp/
/ClientTemp/PongUnity/[Oo]bj/
/ClientTemp/PongUnity/[Bb]uild/
/ClientTemp/PongUnity/[Bb]uilds/
/ClientTemp/PongUnity/[Ll]ogs/
/ClientTemp/PongUnity/[Uu]ser[Ss]ettings/
*.log

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/ClientTemp/PongUnity/[Mm]emoryCaptures/

# Recordings can get excessive in size
/ClientTemp/PongUnity/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /ClientTemp/PongUnity/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/ClientTemp/PongUnity/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
/ClientTemp/PongUnity/.gradle/

# Autogenerated VS/MD/Consulo solution and project files
/ClientTemp/PongUnity/ExportedObj/
/ClientTemp/PongUnity/.consulo/
/ClientTemp/PongUnity/*.csproj
/ClientTemp/PongUnity/*.unityproj
/ClientTemp/PongUnity/*.sln
/ClientTemp/PongUnity/*.suo
/ClientTemp/PongUnity/*.tmp
/ClientTemp/PongUnity/*.user
/ClientTemp/PongUnity/*.userprefs
/ClientTemp/PongUnity/*.pidb
/ClientTemp/PongUnity/*.booproj
/ClientTemp/PongUnity/*.svd
/ClientTemp/PongUnity/*.pdb
/ClientTemp/PongUnity/*.mdb
/ClientTemp/PongUnity/*.opendb
/ClientTemp/PongUnity/*.VC.db

# Unity3D generated meta files
/ClientTemp/PongUnity/*.pidb.meta
/ClientTemp/PongUnity/*.pdb.meta
/ClientTemp/PongUnity/*.mdb.meta

# Unity3D generated file on crash reports
/ClientTemp/PongUnity/sysinfo.txt

# Builds
/ClientTemp/PongUnity/*.apk
/ClientTemp/PongUnity/*.aab
/ClientTemp/PongUnity/*.unitypackage
/ClientTemp/PongUnity/*.unitypackage.meta
/ClientTemp/PongUnity/*.app

# Crashlytics generated file
/ClientTemp/PongUnity/crashlytics-build.properties

# Packed Addressables
/ClientTemp/PongUnity/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/ClientTemp/PongUnity/[Aa]ssets/[Ss]treamingAssets/aa.meta
/ClientTemp/PongUnity/[Aa]ssets/[Ss]treamingAssets/aa/*

# Build outputs
/[Bb]uilds/